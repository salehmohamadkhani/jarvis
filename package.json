{
  "name": "planner-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n server,vite -c cyan,magenta \"node server.js\" \"vite\"",
    "local:stack": "npm run whisper:up && npm run dev:all",
    "whisper:up": "docker compose --profile whisper up -d --build whisper",
    "whisper:down": "docker compose --profile whisper stop whisper",
    "whisper:logs": "docker compose --profile whisper logs -f whisper",
    "build": "vite build",
    "deploy": "npm run build && pm2 restart jarvis",
    "lint": "eslint .",
    "start": "node server.js",
    "preview": "vite preview",
    "telegram-login": "node scripts/telegram-login.mjs",
    "telegram-login-local": "node scripts/telegram-login-local.mjs",
    "test-proxy": "node scripts/test-telegram-proxy.mjs",
    "migrate:collaborators": "node scripts/run-migration-collaborators.cjs",
    "pglite:smoke": "node scripts/pglite-smoke.mjs",
    "ollama:pull": "node scripts/ollama-pull-from-env.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@mantine/colors-generator": "^8.3.8",
    "@mantine/core": "^8.3.8",
    "@mantine/dates": "^8.3.8",
    "@mantine/hooks": "^8.3.8",
    "@middle-management/pglite-pg-adapter": "0.0.4",
    "@tabler/icons-react": "^3.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "googleapis": "^171.4.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "swagger-ui-express": "^5.0.1",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.2"
  }
}

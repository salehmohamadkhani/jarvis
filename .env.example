# ============================================
# JARVIS - نمونه متغیرهای محیطی
# کپی کن: cp .env.example .env.local و مقادیر را پر کن
# ============================================

# دیتابیس PostgreSQL
#
# حالت «بدون Docker و بدون اینترنت» (PGlite داخل Node):
# در `.env.local`:
# USE_PGLITE=true
# پیش‌فرض روی دیسک داخل پروژه ذخیره می‌شود (پوشه‌ی `.data/pglite` gitignore شده).
# (اختیاری) مسیر ذخیره‌سازی روی دیسک (نسبت به روت پروژه):
# PGLITE_DATA_DIR=.data/pglite
# (اختیاری) فقط حافظه (بدون persistence):
# PGLITE_MEMORY=true
#
# حالت پیشنهادی برای توسعهٔ کاملاً آفلاین (Docker روی لوکال):
# 1) `docker compose up -d` (یا `scripts/local-db-up.bat`)
# 2) این مقدار را در `.env.local` بگذار:
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis?sslmode=disable
#
# اگر Postgres روی localhost بالا نباشد و USE_PGLITE هم true نباشد، سرور برای توسعه خودکار
# به PGlite برمی‌گردد (داده در `.data/pglite`). وقتی کانتینر Postgres آماده شد، سرور را دوباره اجرا کن.
#
# اگر از Neon/کلاد استفاده می‌کنی (نیاز به اینترنت/DNS پایدار):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# اختیاری: اجبار SSL سمت Node (معمولاً لازم نیست؛ برای لوکال می‌توان disable کرد)
# PGSSLMODE=disable
#
# اختیاری: تنظیمات اتصال pg (برای شبکه‌های ناپایدار / DNS)
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=8000

# ============================================
# LLM / چت
# ============================================
#
# گزینه ۱ — DeepSeek (پیشنهادی)
#   در `.env.local`:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#   LLM_API_KEY=sk-.......
#   VITE_LLM_MODEL=deepseek-chat
#
# گزینه ۲ — Ollama (لوکال، اوپن‌سورس)
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
#   VITE_LLM_MODEL=llama3.2
#
# اگر LLM_BASE_URL خالی باشد، در حالت توسعه (NODE_ENV غیر production) سرور خودکار
# http://127.0.0.1:11434/v1 را امتحان می‌کند (Ollama روی localhost).
# در production حتماً مقدار را صریح بنویس.
#
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# اگر سرویس LLM نیاز به API Key داشت (برای OpenAI-compatible مثل DeepSeek لازم است)
# LLM_API_KEY=
# مدل پیش‌فرض در فرانت
VITE_LLM_MODEL=llama3.2
# فرانت: تایم‌اوت fetch به /api/chatgpt-proxy (میلی‌ثانیه). پیش‌فرض 360000 = 6 دقیقه (باید >= سرور باشد).
# VITE_LLM_FETCH_TIMEOUT_MS=360000
# فرانت: تعداد تلاش مجدد برای خطای شبکه/۵xx
# VITE_LLM_CLIENT_RETRIES=4
# فرانت: تایم‌اوت STT (میلی‌ثانیه)
# VITE_STT_FETCH_TIMEOUT_MS=180000

# --- Ollama خودش (برای `ollama pull`، نه Node): در ویندوز از System Properties > Environment variables برای User اضافه کن و Ollama را از تری ببند و دوباره باز کن ---
# اگر نسخهٔ Ollama شما پشتیبانی کند، تایم‌اوت pull را زیاد می‌کند (ثانیه):
# OLLAMA_PULL_TIMEOUT=900
# اگر با پروکسی به اینترنت می‌روی (مثلاً clash/v2ray روی 7890):
# HTTPS_PROXY=http://127.0.0.1:7890
# راهنمای رسمی: https://docs.ollama.com/faq

# در صورت تمایل به استفاده از OpenAI به‌جای Ollama (اختیاری):
# OPENAI_API_KEY=sk-...

# Gemini (در صورت استفاده)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# آدرس ریشهٔ بک‌اند برای فرانت (خالی = همان دامنه + پروکسی Vite به /api)
# اگر ست می‌کنی فقط origin بده، مثل: http://127.0.0.1:3001 — مسیر /api خودکار اضافه می‌شود (دیگر لازم نیست .../chatgpt-proxy بنویسی).
VITE_API_BASE_URL=
VITE_BACKEND_URL=

# صدا به متن (STT): فقط Whisper اوپن‌سورس روی سرور (هیچ API پولی استفاده نمی‌شود)
STT_PROVIDER=whisper
# Whisper محلی: آدرس زیر بعد از `npm run whisper:up` (کانتینر سبکِ build-shode داخل repo، نه ایمیج چندگیگابایتی Docker Hub)
# WHISPER_LOCAL_URL=http://localhost:9000/asr
# زبان تشخیص گفتار در فرانت (مرورگر/موبایل). پیش‌فرض فارسی
VITE_STT_LANGUAGE=fa-IR
# صدا به متن دسکتاپ: true = فقط Web Speech مرورگر؛ false = سرور (Whisper اوپن‌سورس محلی). روی موبایل همیشه از سرور استفاده می‌شود.
# برای توسعهٔ آفلاین (بدون سرویس Whisper لوکال)، معمولاً true راحت‌تر است:
# VITE_STT_WEB_SPEECH_ONLY=true
#
# --- ایران / بدون ChatGPT و بدون اتکا به گوگل برای STT ---
# 1) همیشه بک‌اند را لوکال اجرا کن: `npm run start` (پورت 3001) و فرانت: `npm run dev` (Vite پروکسی `/api` را به 3001 می‌فرستد).
# 2) مغز دستیار: LLM_BASE_URL مثل Ollama روی لوکال؛ بدون LLM_BASE_URL و بدون OPENAI_API_KEY، /api/chatgpt-proxy خطای 503 می‌دهد.
# 3) صدا→متن: Web Speech در Chrome اغلب به سرورهای گوگل وصل می‌شود؛ اگر متن نمی‌آید، `npm run whisper:up` را بزن و WHISPER_LOCAL_URL را در .env.local فعال کن (بار اول دانلود مدل؛ بعد تقریباً آفلاین).
# 4) اگر فقط می‌خواهی بدون Whisper تست کنی و Web Speech جواب می‌دهد: VITE_STT_WEB_SPEECH_ONLY=true

# Google Calendar (Service Account) — برای ساخت رویداد از طریق جلسهٔ Jarvis
# تقویم را با client_email سرویس اکانت به اشتراک بگذار (Make changes to events)
GOOGLE_CALENDAR_ID=
# یکی از دو مورد: یا JSON کامل را به صورت رشته اینجا بگذار، یا مسیر فایل JSON
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# GOOGLE_CALENDAR_CREDENTIALS_PATH=./secrets/calendar-service-account.json
GOOGLE_CALENDAR_TIMEZONE=Asia/Tehran

# تلگرام — ارسال پیام از اکانت خودت (بدون ربات؛ همکاران نیازی به استارت ربات ندارند)
# از https://my.telegram.org اپ بساز و API ID و API Hash بگیر. بعد یک بار: npm run telegram-login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# برای دریافت نوتیف به خودت: شماره با + یا یوزرنیم
TELEGRAM_OWNER_PHONE=
TELEGRAM_OWNER_USERNAME=
# سرور داخل ایران: پراکسی برای اتصال به تلگرام (اختیاری)
# روش ۱ — SOCKS5: TELEGRAM_PROXY=socks5://host:port
# روش ۲ — MTProxy (پراکسی رسمی تلگرام از t.me/proxy):
# TELEGRAM_MTPROXY_LINK="https://t.me/proxy?server=...&port=...&secret=..."
# یا: TELEGRAM_MTPROXY_SERVER=... TELEGRAM_MTPROXY_PORT=... TELEGRAM_MTPROXY_SECRET=...

PORT=3001
# دیباگ: وضعیت دیتابیس + Ollama/LLM در یک درخواست — GET http://localhost:3001/api/health?llm=1
